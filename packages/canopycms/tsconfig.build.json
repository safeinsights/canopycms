{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    // Maps off for the PUBLISHED build: we ship "files": ["dist"], not src/,
    // so dist/*.js.map and dist/*.d.ts.map would point at ../src/... paths
    // that aren't in the tarball — dead weight nobody can resolve. tsconfig.json
    // (dev/typecheck) still inherits sourceMap:true from tsconfig.base.json,
    // which is fine since typecheck never emits. Don't re-enable these without
    // also shipping src/.
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": false
  },
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "src/__integration__/**",
    // Workspace-internal only, and deliberately so: these sources import vitest
    // (a devDependency) at module scope, console-spy.ts runs expect.extend() as
    // an import side effect, and it declares a global `declare module 'vitest'`
    // augmentation. Building them would put all three into the published
    // package. The matching half of this decision is that "./test-utils" is
    // absent from package.json's publishConfig.exports while remaining in the
    // dev exports map, so sibling packages can still import it — don't remove
    // this line without also re-reading that. scripts/check-esm-imports.mjs
    // enforces the pairing (its `devOnly` subpath mode).
    "src/test-utils/**",
    "**/*.stories.tsx"
  ]
}
