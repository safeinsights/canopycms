{
  "//": "@codemirror/language, @lezer/highlight: workaround — @mdxeditor/editor uses cm6-theme-basic-light which peer-requires these but mdxeditor doesn't declare them as dependencies",
  "name": "canopycms",
  "version": "0.0.66",
  "description": "CanopyCMS core package: schema-driven content, branch-aware editing, and editor UI for Next.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safeinsights/canopycms.git",
    "directory": "packages/canopycms"
  },
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "canopycms": "./src/cli/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/cache": "./src/auth/cache.ts",
    "./http": "./src/http/index.ts",
    "./task-queue": "./src/task-queue/index.ts",
    "./worker/task-queue": "./src/worker/task-queue.ts",
    "./worker/cms-worker": "./src/worker/cms-worker.ts",
    "./ai": "./src/ai/index.ts",
    "./build": "./src/build/index.ts",
    "./utils/error": "./src/utils/error.ts",
    "./test-utils": "./src/test-utils/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.js",
        "require": "./dist/client.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.js",
        "require": "./dist/server.js"
      },
      "./auth": {
        "types": "./dist/auth/index.d.ts",
        "import": "./dist/auth/index.js",
        "require": "./dist/auth/index.js"
      },
      "./auth/cache": {
        "types": "./dist/auth/cache.d.ts",
        "import": "./dist/auth/cache.js",
        "require": "./dist/auth/cache.js"
      },
      "./http": {
        "types": "./dist/http/index.d.ts",
        "import": "./dist/http/index.js",
        "require": "./dist/http/index.js"
      },
      "./task-queue": {
        "types": "./dist/task-queue/index.d.ts",
        "import": "./dist/task-queue/index.js",
        "require": "./dist/task-queue/index.js"
      },
      "./worker/task-queue": {
        "types": "./dist/worker/task-queue.d.ts",
        "import": "./dist/worker/task-queue.js",
        "require": "./dist/worker/task-queue.js"
      },
      "./worker/cms-worker": {
        "types": "./dist/worker/cms-worker.d.ts",
        "import": "./dist/worker/cms-worker.js",
        "require": "./dist/worker/cms-worker.js"
      },
      "./ai": {
        "types": "./dist/ai/index.d.ts",
        "import": "./dist/ai/index.js",
        "require": "./dist/ai/index.js"
      },
      "./build": {
        "types": "./dist/build/index.d.ts",
        "import": "./dist/build/index.js",
        "require": "./dist/build/index.js"
      },
      "./utils/error": {
        "types": "./dist/utils/error.d.ts",
        "import": "./dist/utils/error.js",
        "require": "./dist/utils/error.js"
      }
    },
    "bin": {
      "canopycms": "./dist/cli/cli.js"
    }
  },
  "scripts": {
    "prepack": "pnpm run build",
    "prebuild": "npx tsx scripts/generate-client.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "postbuild": "node scripts/postbuild.mjs",
    "lint": "eslint src/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:client": "npx tsx scripts/generate-client.ts",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "storybook:build": "storybook build -c .storybook"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-presigned-post": "^3.600.0",
    "@clack/prompts": "^1.1.0",
    "@codemirror/language": "^6.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.13.3",
    "@lezer/highlight": "^1.0.0",
    "@mantine/colors-generator": "^7.14.2",
    "@mantine/core": "^7.14.2",
    "@mantine/dropzone": "7.17.8",
    "@mantine/hooks": "^7.14.2",
    "@mantine/modals": "^7.14.2",
    "@mantine/notifications": "^7.14.2",
    "@mdxeditor/editor": "^3.52.4",
    "@octokit/plugin-throttling": "^8.2.0",
    "@octokit/rest": "^20.0.2",
    "@tabler/icons-react": "^3.36.0",
    "chokidar": "^4.0.3",
    "chroma-js": "^3.2.0",
    "content-disposition": "^2.0.1",
    "fast-deep-equal": "^3.1.3",
    "file-type": "^21.3.2",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.2",
    "jiti": "^2.6.1",
    "minimatch": "^9.0.7",
    "minimist": "^1.2.8",
    "pathe": "^1.1.2",
    "picocolors": "^1.1.1",
    "proper-lockfile": "^4.1.2",
    "react-easy-crop": "^6.2.2",
    "react-split-pane": "^0.1.92",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.3",
    "short-uuid": "^6.0.3",
    "simple-git": "^3.36.0",
    "swr": "^2.4.2",
    "yaml": "^2.8.3",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@smithy/util-stream": "^3.0.0 || ^4.0.0",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-essentials": "^8.1.11",
    "@storybook/react": "^8.1.11",
    "@storybook/react-vite": "^8.1.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.9.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sanitize-html": "^2.16.1",
    "aws-sdk-client-mock": "^4.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.17",
    "tsx": "^4.19.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.0"
  }
}
