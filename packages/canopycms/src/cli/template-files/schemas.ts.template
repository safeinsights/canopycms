import {
  defineEntrySchema,
  defineInlineFieldGroup,
  defineNestedFieldGroup,
  type EntryTypesFromRegistry,
} from 'canopycms'
import { createEntrySchemaRegistry } from 'canopycms/server'

// Define your entry schemas here.
// Each schema describes the fields for a content type.

export const pageSchema = defineEntrySchema([
  { name: 'title', type: 'string', label: 'Title' },
  { name: 'description', type: 'string', label: 'Description' },
  { name: 'body', type: 'markdown', label: 'Body', isBody: true },
])

// --- Field Groups ---
//
// Use defineInlineFieldGroup() to define reusable field sets that render as a
// visually grouped section in the editor. Fields are stored flat in the content
// file — no nested key is created.
//
//   const seoGroup = defineInlineFieldGroup({
//     name: 'seo',
//     label: 'SEO',
//     fields: [
//       { name: 'metaTitle', type: 'string', label: 'Meta Title' },
//       { name: 'metaDescription', type: 'string', label: 'Meta Description' },
//     ],
//   })
//   // TypeFromEntrySchema: { ..., metaTitle: string, metaDescription: string }
//
// Use defineNestedFieldGroup() when you want fields stored under a named key:
//
//   const seoGroup = defineNestedFieldGroup({
//     name: 'seo',
//     label: 'SEO',
//     fields: [
//       { name: 'metaTitle', type: 'string', label: 'Meta Title' },
//       { name: 'metaDescription', type: 'string', label: 'Meta Description' },
//     ],
//   })
//   // TypeFromEntrySchema: { ..., seo: { metaTitle: string, metaDescription: string } }
//
// Include either in a schema by passing it directly as an array element:
//
//   const docSchema = defineEntrySchema([
//     { name: 'title', type: 'string' },
//     seoGroup,
//     { name: 'body', type: 'markdown' },
//   ])

// Uncomment to use:
// export { defineInlineFieldGroup, defineNestedFieldGroup }

// --- Registry ---
//
// Key the registry by ENTRY-TYPE NAME (the filename token in your content files,
// e.g. `page.<slug>.<id>.mdx` → 'page'). The same string is what `.collection.json`
// files reference via the `"schema"` property. Keying this way lets
// `EntryTypesFromRegistry<typeof entrySchemaRegistry>` derive the typed entry-type
// map automatically — see below.

export const entrySchemaRegistry = createEntrySchemaRegistry({
  page: pageSchema,
})

// --- Typed entry-type map ---
//
// Pass `EntryTypes` as the second generic to `canopy.buildContentTree<NavFields, EntryTypes>`
// to get narrowed access to `meta.indexEntry.data` after switching on `meta.entryType`.
// Per-schema aliases derive cleanly from EntryTypes (single source of truth).

export type EntryTypes = EntryTypesFromRegistry<typeof entrySchemaRegistry>

export type PageContent = EntryTypes['page']
