// Type-checks the CDK app. `canopycms init-deploy aws` generated this file, and it is yours to
// edit.
//
// Nothing else checks these files. cdk.json runs the app with tsx, which strips types without
// checking them, and the project's tsconfig.json excludes infrastructure/, so `next build` skips
// them too. Unchecked, a misspelled CanopyCmsService prop is dropped silently and the deploy uses
// that prop's default. .github/workflows/deploy-cms.yml runs `tsc --noEmit -p infrastructure`
// before `cdk deploy`; run the same command after editing the stack.
{
  // tsx reads the project's tsconfig.json too, and honours its "paths" aliases and "jsx" setting,
  // so this file starts from it. Its other compiler options, "strict" included, apply here as well.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // tsx accepts extensionless relative imports, and imports ending in .ts, whether or not
    // package.json declares "type": "module". "bundler" resolution accepts both as well.
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "skipLibCheck": true,
    // Type-check only. An inherited "incremental" would otherwise write a .tsbuildinfo file here.
    "noEmit": true,
    "incremental": false
  },
  // Imports are followed, so canopycms.config.ts, and anything it imports, is checked too.
  "include": ["bin/**/*.ts", "lib/**/*.ts"],
  // Not inherited: an "exclude" from the project's tsconfig.json resolves against the project
  // directory, and that list names infrastructure/, which would exclude every file above.
  "exclude": []
}
