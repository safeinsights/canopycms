# CanopyCMS deployment workflow.
#
# `cdk deploy` is the ONLY thing that ships code here, deliberately.
#
# The generated CDK stack passes the CMS image to CanopyCmsService as
# `lambda.DockerImageCode.fromImageAsset('.', { file: 'Dockerfile.cms' })` -- a
# CDK-built asset. `cdk deploy` builds that image, publishes it to the CDK
# bootstrap assets repository, and points the Lambda at it as part of the
# CloudFormation change set.
#
# So do NOT add a separate `docker build` + push to your own ECR repo followed
# by `aws lambda update-function-code`. That builds the image twice and leaves
# the function's image URI out of sync with CloudFormation's view of it -- the
# next `cdk deploy` that touches the function silently reverts your code to the
# CDK asset. If you want to control the image tag yourself, switch the stack to
# `DockerImageCode.fromEcr(repo, { tagOrDigest })` and keep `cdk deploy` as the
# single deployer; don't run both mechanisms.
#
# `cdk deploy` also rolls the EC2 worker (CanopyCmsService gives its Auto
# Scaling Group a rolling UpdatePolicy), so a worker code change reaches the
# running instance. Expect a short worker outage during the replacement; the
# task queue and branch workspaces live on EFS and are picked up on boot.
#
# This workflow deploys the stack BY NAME rather than with `--all`. If you keep
# other CDK stacks in this repository, `--all` would deploy those too, on every
# content merge -- so if you rename the stack in infrastructure/bin/app.ts,
# rename it in the Deploy step below as well.
#
# Before this workflow can run:
#   1. Bootstrap CDK in the target account/region: `cdk bootstrap`.
#      `cdk deploy` needs it; `aws lambda update-function-code` did not, so
#      this is easy to miss when migrating from an update-only pipeline.
#   2. Create an IAM role your repo can assume via GitHub OIDC, trusted for
#      this repository, able to assume the CDK bootstrap roles
#      (cdk-hnb659fds-*-deploy-role, -file-publishing-role,
#      -image-publishing-role, -lookup-role). This is a broader grant than an
#      update-function-code pipeline needed -- `cdk deploy` mutates
#      infrastructure.
#   3. Install the CDK dependencies the app entry point needs:
#      `{{ADD_DEV}} canopycms-cdk aws-cdk-lib constructs tsx aws-cdk`
#   4. Set these repository secrets (Settings -> Secrets and variables ->
#      Actions -> Secrets). Every one of them is read by `required()` in
#      infrastructure/bin/app.ts, so a missing value fails the deploy at synth:
#        AWS_DEPLOY_ROLE_ARN            OIDC role ARN from step 2
#        GITHUB_TOKEN_SECRET_ARN        FULL Secrets Manager ARN (with suffix)
#        CLERK_SECRET_KEY_SECRET_ARN    FULL Secrets Manager ARN (with suffix)
#        CLERK_JWT_KEY                  Clerk's public JWKS PEM
#   5. Set these repository variables (same page -> Variables):
#        AWS_REGION                          e.g. us-east-1
#        NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY   or the editor ships unable to sign in
#        CANOPY_BOOTSTRAP_ADMIN_IDS          comma-separated Clerk user IDs
#      Optional:
#        CANOPYCMS_DEPLOYMENT_NAME           defaults to 'prod'
#        CMS_DOMAIN_NAME                     enables CloudFront + Route53
#        CMS_HOSTED_ZONE_DOMAIN              required alongside CMS_DOMAIN_NAME

name: Deploy CMS

on:
  push:
    branches: [{{DEFAULT_BRANCH}}]
    paths:
      - 'app/**'
      - 'src/**'
      - 'content/**'
      - 'canopycms.config.ts'
      # The Next config is what `init-deploy aws` itself tells you to edit for
      # the dual build, and `public/**` is copied into the runner image (and is
      # load-bearing for editor/public preview parity). Omitting them meant an
      # edit shipped days later, piggybacked on an unrelated content change --
      # so any breakage was attributed to the wrong commit.
      - 'next.config.*'
      - 'middleware.ts'
      - 'public/**'
      - 'Dockerfile.cms'
      - 'infrastructure/**'
      - 'cdk.json'
      # A dependency bump alone changes what the image contains, so it has to
      # trigger a deploy too -- otherwise the Lambda keeps running the old
      # dependency tree until the next content change happens to ship it.
      - 'package.json'
      - '{{LOCKFILE}}'
  workflow_dispatch:

concurrency:
  # Two overlapping `cdk deploy` runs against one stack fail on
  # UPDATE_IN_PROGRESS. Queue rather than cancel: cancelling mid-deploy leaves
  # the stack in an in-progress state that needs manual recovery.
  group: deploy-cms
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    permissions:
      id-token: write # required for OIDC
      contents: read

    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4

      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: 22

      - name: Install dependencies
        run: {{CI_INSTALL}}

      # cdk.json runs `node --import tsx infrastructure/bin/app.ts`, which
      # imports canopycms-cdk, aws-cdk-lib and constructs. Missing any of them
      # otherwise surfaces as an ERR_MODULE_NOT_FOUND buried in `cdk deploy`
      # output, several minutes in.
      #
      # aws-cdk is checked too even though nothing imports it: it is the CLI
      # the Deploy step invokes as `npx cdk`. Absent from node_modules, npx
      # silently fetches whatever version is current that day instead of
      # failing -- so the deploy still runs, just not reproducibly. Keep this
      # list in step with CDK_DEPENDENCIES in cli/project-detect.ts, which is
      # what `canopycms init-deploy` tells adopters to install.
      - name: Check CDK dependencies are installed
        run: |
          missing=""
          for pkg in tsx aws-cdk-lib constructs canopycms-cdk aws-cdk; do
            [ -e "node_modules/$pkg" ] || missing="$missing $pkg"
          done
          if [ -n "$missing" ]; then
            echo "::error::Missing CDK dependencies:$missing"
            echo "::error::Install them with: {{ADD_DEV}} canopycms-cdk aws-cdk-lib constructs tsx aws-cdk"
            exit 1
          fi

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@7474bc4690e29a8392af63c5b98e7449536d5c3a # v4
        with:
          role-to-assume: ${{ secrets.AWS_DEPLOY_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION }}

      # Builds the CMS image, publishes it to the CDK assets repository, and
      # applies the change set -- Lambda, EFS, CloudFront and the worker ASG
      # in one operation.
      #
      # Every variable below is consumed by infrastructure/bin/app.ts. Keep
      # this block in step with the `required()` calls there: a variable added
      # in one place and not the other fails the deploy at synth.
      - name: Deploy
        env:
          GITHUB_TOKEN_SECRET_ARN: ${{ secrets.GITHUB_TOKEN_SECRET_ARN }}
          CLERK_SECRET_KEY_SECRET_ARN: ${{ secrets.CLERK_SECRET_KEY_SECRET_ARN }}
          CLERK_JWT_KEY: ${{ secrets.CLERK_JWT_KEY }}
          NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY: ${{ vars.NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY }}
          CANOPY_BOOTSTRAP_ADMIN_IDS: ${{ vars.CANOPY_BOOTSTRAP_ADMIN_IDS }}
          CANOPYCMS_DEPLOYMENT_NAME: ${{ vars.CANOPYCMS_DEPLOYMENT_NAME }}
          CMS_DOMAIN_NAME: ${{ vars.CMS_DOMAIN_NAME }}
          CMS_HOSTED_ZONE_DOMAIN: ${{ vars.CMS_HOSTED_ZONE_DOMAIN }}
        run: npx cdk deploy {{STACK_NAME}} --require-approval never
