  mode: '{{MODE}}',
{{DEPLOYED_AS}}  gitBotAuthorName: 'CanopyCMS Bot',
  gitBotAuthorEmail: 'canopycms-bot@example.com',
  editor: {
    title: 'CanopyCMS Editor',
  },
})
