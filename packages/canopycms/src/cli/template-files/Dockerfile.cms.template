# Node 22. Node 20 reached upstream EOL on 2026-04-30, so it receives no
# further security patches -- and the CMS Lambda runs this image.
#
# NOTE: the published canopycms packages declare `engines.node: ">=18"`,
# so this is not an installability floor -- it is the runtime CanopyCMS is
# actually built and tested on (.nvmrc is v22, as is the transform Lambda).
FROM public.ecr.aws/docker/library/node:22-slim AS builder
WORKDIR /app
{{DOCKER_COPY}}
# If your app uses `file:` dependencies (e.g. vendored tarballs under vendor/),
# COPY that directory here, before the install step -- otherwise it fails.
# The same applies to a patches/ directory named by pnpm's patchedDependencies.
#
# This assumes a single-package repository. In a workspace monorepo (a
# pnpm-workspace.yaml that lists `packages`, or npm/yarn `workspaces`) the
# files above are not enough on their own -- copy the workspace manifests and
# install with the workspace filtered to this app.
{{DOCKER_INSTALL}}
COPY . .
# Guard against adopter apps with no public/ directory: Next's standalone
# output still expects one, and the runner stage below copies it.
RUN mkdir -p public
# Build-time content reads (generateStaticParams, prerendering, sitemaps) come
# straight from the files copied above -- the working tree at /app -- in either
# operating mode. Nothing here touches git, a branch clone or .canopy-dev, so
# this stage needs neither git nor a repository (.dockerignore excludes .git).
# CANOPY_BUILD_MODE=true extends that to anything else the build command below
# runs that reads content outside `next build` (e.g. `canopycms
# generate-ai-content`).
# A command that does need git -- `canopycms sync`, say -- does not belong in
# this stage.
#
# Leave CANOPY_MODE unset here. Nothing in the build needs prod, and prod mode
# would hold the builder to run-time checks it has no reason to meet
# (gitBotAuthorName/gitBotAuthorEmail, an auth plugin that verifies
# credentials). CANOPY_MODE is read at RUN time by resolveOperatingMode
# (canopycms/src/operating-mode/mode-env.ts) and wins over the `mode` literal
# in canopycms.config.ts, so the image builds with the config's `dev` and runs
# in prod because CanopyCmsService sets CANOPY_MODE=prod on the Lambda. Keep
# the config file saying dev -- `next dev` needs it.
ENV CANOPY_BUILD=cms
ENV CANOPY_BUILD_MODE=true
# Next.js inlines NEXT_PUBLIC_* values into the client bundle at `next build`
# time, and the generated Clerk edit page needs the publishable key. The
# publishable key is public material, so it's safe to bake into image layers.
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
# The browser needs the operating mode too: the editor page is a client
# component that imports canopycms.config.ts, so its copy of `mode` is whatever
# was inlined at build time -- a runtime Lambda variable can never reach it.
# Left as dev by default (the default target of a plain `docker build`); the
# generated CDK stack passes `prod` as a build arg. Distinct from CANOPY_MODE
# above on purpose: this one is read only in the browser, so setting it here
# does NOT put the build's own server-side content reads into prod mode.
ARG NEXT_PUBLIC_CANOPY_MODE=dev
ENV NEXT_PUBLIC_CANOPY_MODE=$NEXT_PUBLIC_CANOPY_MODE
RUN {{DOCKER_BUILD}}

FROM public.ecr.aws/docker/library/node:22-slim AS runner
# Git is required by CanopyCMS for branch operations
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*
# The runtime user's uid differs from the uid that owns EFS workspace files
# (access point forces 1000); git >= 2.35.2 refuses "dubious ownership".
# safe.directory must live in PROTECTED configuration - system config is the
# most robust scope (env-based GIT_CONFIG_* can be stripped by spawn wrappers).
RUN git config --system safe.directory '*'
# Lambda Web Adapter converts Lambda events to HTTP
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.0.1 /lambda-adapter /opt/extensions/lambda-adapter
WORKDIR /app
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
# Lambda's filesystem is read-only outside /tmp. Next may write to .next/cache
# at runtime; symlink it to /tmp so those writes succeed instead of failing (EROFS).
RUN rm -rf .next/cache && ln -s /tmp .next/cache
ENV PORT=8080 AWS_LWA_PORT=8080 HOSTNAME=0.0.0.0 NODE_ENV=production
CMD ["node", "server.js"]
