import { clerkMiddleware, createRouteMatcher } from '@clerk/nextjs/server'

const isProtectedRoute = createRouteMatcher(['/edit(.*)', '/api/canopycms(.*)'])

// Without an explicit jwtKey, @clerk/nextjs fetches JWKS from api.clerk.com on
// every cold verification -- the prod CMS Lambda has no internet and hangs.
// With it, verification is a local PEM operation (the env var alone does
// nothing; it appears only in Clerk error messages).
export default clerkMiddleware(
  async (auth, req) => {
    if (isProtectedRoute(req)) {
      await auth.protect()
    }
  },
  { jwtKey: process.env.CLERK_JWT_KEY },
)

export const config = {
  matcher: ['/edit(.*)', '/api/canopycms(.*)'],
}
