import { clerkMiddleware, createRouteMatcher } from '@clerk/nextjs/server'

const isProtectedRoute = createRouteMatcher(['/edit(.*)', '/api/canopycms(.*)'])

// This middleware is optional. CanopyCMS authenticates /api/canopycms without
// it: createNextCanopyContext wraps the Clerk auth plugin in CachingAuthPlugin,
// which verifies each request's Clerk token with CLERK_JWT_KEY alone and reads
// user and group metadata from the auth cache. What this file adds is turning
// signed-out requests to /edit and /api/canopycms away before they reach the
// app. On a deployed CMS Lambda it costs two things:
//   - CLERK_SECRET_KEY on the Lambda. clerkMiddleware throws on every request
//     it matches unless it can resolve a secret key (jwtKey doesn't count),
//     which breaks the public-keys-only Lambda that the Security Model in
//     docs/deploying-to-aws.md describes.
//   - One image per Clerk instance. It reads the publishable key inlined at
//     image build (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY), not the one your
//     ClerkProvider receives, unless you pass it an options callback that
//     reads both keys at run time.
// To run without it, delete this file; docs/deploying-to-aws.md ("One image
// for every Clerk tier") describes that shape.
//
// Without an explicit jwtKey, @clerk/nextjs fetches JWKS from api.clerk.com on
// every cold verification -- the prod CMS Lambda has no internet and hangs.
// With it, verification is a local PEM operation (the env var alone does
// nothing; it appears only in Clerk error messages).
export default clerkMiddleware(
  async (auth, req) => {
    if (isProtectedRoute(req)) {
      await auth.protect()
    }
  },
  { jwtKey: process.env.CLERK_JWT_KEY },
)

export const config = {
  matcher: ['/edit(.*)', '/api/canopycms(.*)'],
}
