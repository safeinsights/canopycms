import { NextResponse } from 'next/server'

// Protect CMS routes from unauthenticated access.
//
// For dev auth mode, no middleware protection is needed — this file is a passthrough.
// If you don't need auth protection, you can delete this file entirely.
//
// For Clerk auth, replace this file's contents with:
//
//   import { clerkMiddleware, createRouteMatcher } from '@clerk/nextjs/server'
//
//   const isProtectedRoute = createRouteMatcher(['/edit(.*)', '/api/canopycms(.*)'])
//
//   // jwtKey avoids a JWKS fetch to api.clerk.com on cold verification --
//   // the prod CMS Lambda has no internet.
//   export default clerkMiddleware(
//     async (auth, req) => {
//       if (isProtectedRoute(req)) {
//         await auth.protect()
//       }
//     },
//     { jwtKey: process.env.CLERK_JWT_KEY },
//   )
//
//   export const config = {
//     matcher: ['/edit(.*)', '/api/canopycms(.*)'],
//   }
//
// IMPORTANT: unlike canopy.ts and the edit page, this file does NOT read
// CANOPY_AUTH_MODE at runtime -- it is frozen at `init` time. If you switch
// from dev to Clerk auth (or flip CANOPY_AUTH_MODE=clerk), choose what this
// file becomes. The Clerk middleware above turns signed-out requests away
// before they reach the app, but needs CLERK_SECRET_KEY wherever it runs.
// Deleting the file relies on the Clerk auth plugin alone, which rejects
// unauthenticated API calls on its own (the core also fails closed in prod
// mode), and keeps the secret off a deployed CMS Lambda -- see "One image for
// every Clerk tier" in docs/deploying-to-aws.md. Keeping this passthrough with
// Clerk behaves like deleting it; the warning below is there so that it's a
// choice rather than an oversight.

let warnedAuthModeMismatch = false

export default function middleware() {
  if (process.env.CANOPY_AUTH_MODE === 'clerk' && !warnedAuthModeMismatch) {
    warnedAuthModeMismatch = true
    console.warn(
      '[canopycms] CANOPY_AUTH_MODE=clerk is set, but middleware.ts is still the dev ' +
        'passthrough generated for dev auth. Replace it with the Clerk middleware (see the ' +
        'comment above), or delete it to rely on the Clerk auth plugin alone.',
    )
  }
  return NextResponse.next()
}

export const config = {
  matcher: ['/edit(.*)', '/api/canopycms(.*)'],
}
