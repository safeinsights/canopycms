import { NextResponse } from 'next/server'

// Optional edge protection for CMS routes. This passthrough adds none, and the CMS
// is protected without it in every auth mode: the API authenticates every request
// itself, and the editor shows the auth provider's sign-in screen to signed-out
// users (EditorAuthGate).
//
// With Clerk, clerkMiddleware can add an edge check plus a redirect to sign-in
// before the editor loads, but it requires CLERK_SECRET_KEY in this runtime (it
// throws without one). Keep this passthrough to keep the secret off the CMS
// runtime -- e.g. a no-internet Lambda, where the worker holds the secret. To add
// the edge check instead, replace this file's contents with:
//
//   import { clerkMiddleware, createRouteMatcher } from '@clerk/nextjs/server'
//
//   const isProtectedRoute = createRouteMatcher(['/edit(.*)', '/api/canopycms(.*)'])
//
//   // jwtKey avoids a JWKS fetch to api.clerk.com on cold verification --
//   // the prod CMS Lambda has no internet.
//   export default clerkMiddleware(
//     async (auth, req) => {
//       if (isProtectedRoute(req)) {
//         await auth.protect()
//       }
//     },
//     { jwtKey: process.env.CLERK_JWT_KEY },
//   )
//
//   export const config = {
//     matcher: ['/edit(.*)', '/api/canopycms(.*)'],
//   }
//
// IMPORTANT: unlike canopy.ts and the edit page, this file does NOT read
// CANOPY_AUTH_MODE at runtime -- it is frozen at `init` time. If you switch
// from dev to Clerk auth (or flip CANOPY_AUTH_MODE=clerk), choose what this
// file becomes: the Clerk middleware above, or this passthrough (the same as
// no file), which keeps the secret off a deployed CMS Lambda -- see "One image
// for every Clerk tier" in docs/deploying-to-aws.md. The warning below is there
// so that it's a choice rather than an oversight.

let warnedAuthModeMismatch = false

export default function middleware() {
  if (process.env.CANOPY_AUTH_MODE === 'clerk' && !warnedAuthModeMismatch) {
    warnedAuthModeMismatch = true
    console.warn(
      '[canopycms] CANOPY_AUTH_MODE=clerk is set, but middleware.ts is still the dev ' +
        'passthrough generated for dev auth. Replace it with the Clerk middleware (see the ' +
        "comment above), or keep it to rely on the API's own auth and the editor's sign-in.",
    )
  }
  return NextResponse.next()
}

export const config = {
  matcher: ['/edit(.*)', '/api/canopycms(.*)'],
}
