{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": false,
    // Maps off for the PUBLISHED build: we ship "files": ["dist"], not src/,
    // so dist/*.js.map and dist/*.d.ts.map would point at ../src/... paths
    // that aren't in the tarball — dead weight nobody can resolve. tsconfig.json
    // (dev/typecheck) keeps sourceMap on (inherited from tsconfig.base.json)
    // for local editing/debugging. Don't re-enable these without also
    // shipping src/.
    "declarationMap": false,
    "sourceMap": false
  },
  // No exclude existed at all before this — dev-plugin.test.ts compiled straight
  // into dist/dev-plugin.test.{js,d.ts} and shipped in the published tarball
  // (not reachable via the package's exports map, but dead weight all the
  // same). Matches the pattern canopycms-auth-clerk's tsconfig.build.json
  // already uses.
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
