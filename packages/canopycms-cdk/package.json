{
  "name": "canopycms-cdk",
  "version": "0.0.60",
  "description": "AWS CDK constructs and EC2 worker for CanopyCMS deployment",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safeinsights/canopycms.git",
    "directory": "packages/canopycms-cdk"
  },
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "worker/dist",
    "worker/canopy-worker.service",
    "lambda/asset-transform/dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "scripts": {
    "prepack": "pnpm run build && pnpm run build:worker && pnpm run build:lambda",
    "build": "tsc",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=worker/dist/index.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "build:lambda": "node lambda/asset-transform/build.mjs",
    "build:test-fixtures": "pnpm run build:worker && node lambda/asset-transform/build.mjs --skip-native",
    "lint": "eslint src/ 'lambda/**/*.ts' 'canary/**/*.ts' 'worker/**/*.ts'",
    "test": "pnpm run build:test-fixtures && vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p lambda/tsconfig.json && tsc --noEmit -p canary/tsconfig.json && tsc --noEmit -p worker/tsconfig.json"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.192.0",
    "constructs": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "aws-cdk-lib": {
      "optional": true
    },
    "constructs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/aws-lambda": "^8.10.145",
    "aws-cdk-lib": "^2.192.0",
    "canopycms": "workspace:*",
    "canopycms-auth-clerk": "workspace:*",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "@smithy/util-stream": "^3.0.0 || ^4.0.0",
    "aws-sdk-client-mock": "^4.0.0",
    "constructs": "^10.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.0"
  }
}
