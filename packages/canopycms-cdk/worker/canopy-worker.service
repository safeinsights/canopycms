[Unit]
Description=CanopyCMS Worker Daemon
After=network.target
# Never run against an unmounted workspace filesystem (matches the deployed
# copy of this unit, which cms-service.ts user-data writes with an fstab
# entry for /mnt/efs).
RequiresMountsFor=/mnt/efs

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/canopy-worker
ExecStart=/usr/bin/node-22 index.js
Restart=always
RestartSec=5
TimeoutStartSec=300
# Stopping drains: SIGTERM reaches node ONLY (mixed), so the git children it
# waits for keep running. Whatever is left when node exits, or at
# TimeoutStopSec, is SIGKILLed; 120s outlasts the 90s drain and its abort grace.
KillMode=mixed
TimeoutStopSec=120
# A worker that drained for an instance termination exits with 75; restarting
# it would start work on an instance about to disappear.
RestartPreventExitStatus=75
SuccessExitStatus=75
# File output, not journal: the CloudWatch agent cannot read journald,
# so it tails this file instead (agent config lives in the cms-service.ts
# user-data, which writes the deployed copy of this unit).
# systemd opens append: targets as root, following symlinks, before it
# applies the sandbox or drops to User=. So the worker must own neither the
# file nor its directory: one that could swap worker.log for a symlink would
# have its output appended to any file on the host as root. Hence no
# LogsDirectory=, which chowns the directory to User=. Create both, root-owned,
# BEFORE the first start (without the directory the exec fails with 209/STDOUT
# and Restart=always crash-loops):
#   install -d -o root -g root -m 0755 /var/log/canopy-worker
#   install -o root -g root -m 0644 /dev/null /var/log/canopy-worker/worker.log
StandardOutput=append:/var/log/canopy-worker/worker.log
StandardError=append:/var/log/canopy-worker/worker.log

# The private GitHub mirror, /var/lib/canopy-worker on the root volume: the
# only git repository the GitHub credential is used in. The worker does not
# start without it.
StateDirectory=canopy-worker

# Environment
EnvironmentFile=/opt/canopy-worker/.env
# The worker contract this unit provides (WORKER_CONTRACT_VERSION in
# src/constructs/worker-lifecycle.ts); a bundle needing more refuses to start.
Environment=CANOPYCMS_WORKER_CONTRACT=1

# Sandbox. Writable: the workspace, the state dir (StateDirectory=) and a
# private /tmp.
# ProtectHome=tmpfs, not yes: every git call reads per-user files under $HOME
# (~/.config/git/attributes, ignore), and an inaccessible /home makes each read
# warn "Permission denied"; an empty one is a silent ENOENT.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadWritePaths=/mnt/efs

[Install]
WantedBy=multi-user.target
