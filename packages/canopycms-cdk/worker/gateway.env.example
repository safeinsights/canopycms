# /opt/canopy-worker/gateway.env: canopy-github.service's environment, for a hand install.
# Create it unreadable to the worker's user, before writing to it:
#   install -m 0640 -o root -g canopy-github /dev/null /opt/canopy-worker/gateway.env
# The worker's own .env carries CANOPYCMS_WORKSPACE_ROOT, CANOPYCMS_GITHUB_OWNER,
# CANOPYCMS_GITHUB_REPO, CANOPYCMS_DEPLOYMENT_NAME and, when set, CANOPYCMS_BASE_BRANCH and
# CANOPYCMS_SETTINGS_BRANCH, and nothing secret: the worker refuses to start beside a secret.
CANOPYCMS_GITHUB_OWNER=your-org
CANOPYCMS_GITHUB_REPO=your-site
AWS_REGION=us-east-1
# The branch the worker syncs; the gateway never pushes it. Set it here and in the worker's .env.
CANOPYCMS_BASE_BRANCH=main
# A token, by its Secrets Manager ARN (and the field, for a JSON secret)...
CANOPYCMS_GITHUB_TOKEN_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:github-token
#CANOPYCMS_GITHUB_TOKEN_SECRET_JSON_FIELD=token
# ...or a GitHub App: all three, and no token.
#CANOPYCMS_GITHUB_APP_ID=123456
#CANOPYCMS_GITHUB_APP_INSTALLATION_ID=7890123
#CANOPYCMS_GITHUB_APP_PRIVATE_KEY_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:github-app-key
#CANOPYCMS_GITHUB_APP_PRIVATE_KEY_SECRET_JSON_FIELD=privateKey
CLERK_SECRET_KEY_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:clerk-secret-key
#CLERK_SECRET_KEY_SECRET_JSON_FIELD=secretKey
# Map Clerk Organizations onto Canopy groups (default true); false on an instance without Organizations.
#CANOPYCMS_CLERK_ORGANIZATIONS_AS_GROUPS=false
# Branches the gateway never pushes, deletes or opens a pull request from: names and `*` globs.
#CANOPYCMS_PROTECTED_BRANCHES=release/*,production
# On spot capacity, so the gateway watches for an interruption notice too.
#CANOPYCMS_WORKER_CAPACITY=spot
